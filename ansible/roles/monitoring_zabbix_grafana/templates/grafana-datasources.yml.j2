apiVersion: 1
datasources:
  - name: Zabbix
    uid: zabbix-nexo
    type: alexanderzobnin-zabbix-datasource
    access: proxy
    url: https://127.0.0.1/zabbix/api_jsonrpc.php
    isDefault: true
    editable: false
    jsonData:
      username: grafana-ro
      trends: true
      trendsFrom: 7d
      trendsRange: 4d
      cacheTTL: 1m
      timeout: 30
      tlsSkipVerify: true          # certificado autofirmado de la propia VM (loopback)
      disableDataAlignment: false
    secureJsonData:
      password: $__file{/etc/grafana/zabbix_ro_password}
{% if grafana_azure_subscription_id | length > 0 %}
  - name: Azure Monitor
    uid: azure-monitor
    type: grafana-azure-monitor-datasource
    access: proxy
    editable: false
    jsonData:
      azureAuthType: msi           # identidad administrada de la VM (rol «Monitoring Reader» en el grupo de recursos); sin claves
      subscriptionId: "{{ grafana_azure_subscription_id }}"
      cloudName: azuremonitor
{% endif %}
