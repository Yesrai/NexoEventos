# Gestionado por Ansible. Solo HTTPS. Nginx 1.24 (Ubuntu 24.04): `http2` va en la directiva listen.
server {
    listen 443 ssl http2 default_server;
    server_name {{ monitoring_fqdn }};

    ssl_certificate     /etc/ssl/nexo-obs/cert.pem;
    ssl_certificate_key /etc/ssl/nexo-obs/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:NexoObsTLS:5m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    client_max_body_size 4m;

    location = / { return 302 /grafana/; }

    location /grafana/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # Zabbix: /usr/share/zabbix se sirve en /zabbix/
    root /usr/share;
    location /zabbix/ {
        index index.php;
        try_files $uri $uri/ =404;
    }
    location ~ ^/zabbix/.+\.php$ {
        fastcgi_pass unix:/run/php/zabbix.sock;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_read_timeout 300;
    }
    location ~ ^/zabbix/(conf|app|include|local|vendor)/ { deny all; }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
