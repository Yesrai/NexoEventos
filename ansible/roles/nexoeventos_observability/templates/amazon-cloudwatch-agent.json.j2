{
  "agent": {
    "debug": false,
    "region": "{{ nexoeventos_cloudwatch_region }}",
    "run_as_user": "root"
  },
  "logs": {
    "force_flush_interval": 5,
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "{{ nexoeventos_api_log }}",
            "log_group_name": "/nexoeventos/{{ nexoeventos_environment }}/api",
            "log_stream_name": "{instance_id}/service"
          },
          {
            "file_path": "{{ nexoeventos_nginx_access_log }}",
            "log_group_name": "/nexoeventos/{{ nexoeventos_environment }}/nginx",
            "log_stream_name": "{instance_id}/access",
            "timezone": "UTC",
            "timestamp_format": "%Y-%m-%dT%H:%M:%S%z"
          },
          {
            "file_path": "{{ nexoeventos_nginx_error_log }}",
            "log_group_name": "/nexoeventos/{{ nexoeventos_environment }}/nginx",
            "log_stream_name": "{instance_id}/error"
          }
        ]
      }
    }
  }
}
