[Unit]
Description=NexoEventos FastAPI service (versioned release)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexoeventos
Group=nexoeventos
WorkingDirectory={{ nexoeventos_release_root }}/current/backend
EnvironmentFile=/etc/nexoeventos/backend.env
ExecStart={{ nexoeventos_release_root }}/current/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ProtectProc=invisible
RestrictSUIDSGID=true
LockPersonality=true
LogsDirectory=nexoeventos
StandardOutput=append:/var/log/nexoeventos/api.log
StandardError=append:/var/log/nexoeventos/api.log

[Install]
WantedBy=multi-user.target
