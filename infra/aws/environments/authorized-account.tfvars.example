aws_region     = "us-east-1"
project_slug   = "nexoeventos"
environment    = "destination"

# Nunca copiar el ID de Academy. Confirmar identidad, cuotas, precios y permisos del destino.
expected_account_id       = "REPLACE_WITH_DESTINATION_ACCOUNT_ID"
instance_profile_name     = "REPLACE_WITH_DESTINATION_PROFILE"
final_snapshot_identifier = "nexoeventos-destination-final-20261126"

admin_cidr               = ""
ec2_instance_type        = "t3.small"
ec2_root_volume_gib      = 20
db_instance_class        = "db.t3.micro"
db_allocated_storage_gib = 20
backup_retention_days    = 7
log_retention_days       = 7
