{
  "agent": { "region": "${AWS_REGION}", "run_as_user": "root" },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/nexoeventos/api.log", "log_group_name": "/nexoeventos/${ENVIRONMENT}/api", "log_stream_name": "{instance_id}", "retention_in_days": 7 },
          { "file_path": "/var/log/nginx/error.log", "log_group_name": "/nexoeventos/${ENVIRONMENT}/nginx", "log_stream_name": "{instance_id}-error", "retention_in_days": 7 }
        ]
      }
    }
  }
}
