# /etc/nexoeventos/backup.env  (root:root 0600) — EJEMPLO sin credenciales. Lo lee nexoeventos-backup.service (EnvironmentFile).
# El rol nexoeventos_backup es de SOLO LECTURA (deploy/backup/backup-role.sql). La contraseña real solo vive en la EC2, nunca en Git ni en la línea de órdenes.
# verify-full valida la CA y el nombre del servidor de RDS: exige el paquete de CA de RDS (deploy/install-rds-ca-bundle.sh, con SHA-256 verificado).
DATABASE_URL=postgresql://nexoeventos_backup:CAMBIAR@<endpoint-rds>:5432/nexoeventos?sslmode=verify-full&sslrootcert=/etc/nexoeventos/rds-ca-bundle.pem
