APP_ENV=production
DATABASE_URL=postgresql+psycopg://nexoeventos_app:REPLACE_FROM_SECRET@REPLACE_RDS_ENDPOINT/nexoeventos?sslmode=require
FRONTEND_ORIGINS=https://nexoeventos-demo.duckdns.org
SESSION_COOKIE_SECURE=true
SESSION_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=15
TICKET_ENCRYPTION_KEY=REPLACE_FROM_SEPARATE_SECRET
SECURITY_HASH_KEY=REPLACE_FROM_SEPARATE_SECRET
