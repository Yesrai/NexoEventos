 if [[ ${rc[1]} -ne 0 ]]; then echo "FALLÓ la restauración remota (ssh/remote-restore código ${rc[1]}); revise la salida anterior." >&2; exit 8; fi
 mark "volcado descifrado localmente, transmitido por SSH y restaurado"
