# Drop-in de systemd para el backend de la EC2 en la PRUEBA HÍBRIDA (NO se aplica sola). Rutas a archivos 0600; ningún secreto en línea.
# /etc/systemd/system/nexoeventos-api.service.d/hybrid-gate.conf  →  [Service] + estas líneas con «Environment=»
WRITE_GATE_MODE=enforce
WRITE_GATE_ROLE=primary
WRITE_GATE_HOLDER_ID=aws-primary
WRITE_GATE_STORE=par-http
WRITE_GATE_PAR_URL_FILE=/etc/nexoeventos/fence/lease-par.url
WRITE_GATE_OCI_OBJECT=writer-lease.json
WRITE_GATE_DB_FENCE=require
WRITE_GATE_APP_ROLE=nexoeventos_app
WRITE_GATE_FENCE_DATABASE_URL_FILE=/etc/nexoeventos/fence/keeper.url
WRITE_GATE_ATTEST_PAR_URL_FILE=/etc/nexoeventos/fence/attest-par.url
WRITE_GATE_ATTEST_OBJECT=fence-attestation.json
# TTL/margen por defecto del lease: 15 s / 5 s (la autoridad de la base dura como máximo TTL−margen = 10 s sin renovar)
