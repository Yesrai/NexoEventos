# Imagen LOCAL del laboratorio: la imagen de desarrollo existente (dependencias ya instaladas, de 22-oct) + el código ACTUAL de backend/app y backend/alembic.
# Se construye con --network=none: no descarga nada. No modifica el backend del repositorio.
FROM nexoeventos-dev-backend:latest
COPY --chown=10001:10001 app /app/app
COPY --chown=10001:10001 alembic /app/alembic
